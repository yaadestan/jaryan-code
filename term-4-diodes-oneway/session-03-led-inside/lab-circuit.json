      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 33,
        "initial": 33,
        "label": "ولتاژ منبع (ضرب‌در ۰٫۱ ولت)"
      },
      {
        "type": "led",
        "pin": 99,
        "color": "red",
        "label": "LED1"
      },
      {
        "type": "led",
        "pin": 98,
        "color": "blue",
        "label": "LED2"
      }
    ],
    "analog": {
      "sources": [
        {
          "pin": 14,
          "net": "vs"
        }
      ],
      "reads": [
        {
          "pin": 34,
          "net": "knob"
        }
      ],
      "pots": [
        {
          "id": "KNOB",
          "pin": 34,
          "analogMax": 33
        }
      ],
      "components": [
        {
          "kind": "pot",
          "id": "KNOB",
          "a": "3V3",
          "wiper": "knob",
          "b": "GND",
          "rtotal": 10000,
          "wiperPos": 0.3
        },
        {
          "kind": "resistor",
          "id": "R1",
          "a": "vs",
          "b": "a",
          "ohms": 330
        },
        {
          "kind": "led",
          "id": "LED1",
          "anode": "a",
          "cathode": "GND",
          "pin": 99
        },
        {
