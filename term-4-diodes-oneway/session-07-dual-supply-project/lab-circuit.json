{
  "key": "term-4-diodes-oneway/session-07-dual-supply-project",
  "config": {
    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# jaryan: manba-e voltazh-e ghabel-e tanzim-e azmayeshgah.\n# har gam-e slider 0.1 volt ast; duty * 3.3 / 1023 = tenths / 10 volt.\nfrom machine import Pin, ADC, PWM\nimport time\n\nknob = ADC(Pin(34))\nknob.atten(ADC.ATTN_11DB)\nsupply = PWM(Pin(14), freq=1000)\n\ntenths = round(knob.read() * 33 / 4095)\nsupply.duty(tenths * 31)\n\nwhile True:\n    time.sleep(0.2)\n",
    "parts": [
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 33,
        "initial": 33,
        "label": "منبع اصلی (ضرب‌در ۰٫۱ ولت)"
      },
      {
        "type": "analog",
        "pin": 35,
        "sensor": "pot",
        "analogMax": 100,
        "initial": 22,
        "label": "مقاومت load (ضرب‌در ۱۰۰ اهم)"
      },
      {
        "type": "analog",
        "pin": 32,
        "sensor": "pot",
        "analogMax": 1,
        "initial": 0,
        "label": "پل روی D2 (۰ باز، ۱ بسته)"
      }
    ],
    "analog": {
      "sources": [
        {
          "pin": 14,
          "net": "vs"
        }
      ],
      "reads": [
        {
          "pin": 34,
          "net": "knob"
        }
      ],
      "pots": [
        {
          "id": "KNOB",
          "pin": 34,
          "analogMax": 33
        },
        {
          "id": "RL",
          "pin": 35,
          "analogMax": 100
        },
        {
          "id": "BP",
          "pin": 32,
          "analogMax": 1
        }
      ],
      "components": [
        {
          "kind": "pot",
          "id": "KNOB",
          "a": "3V3",
          "wiper": "knob",
          "b": "GND",
          "rtotal": 10000,
          "wiperPos": 0.3
        },
        {
          "kind": "pot",
          "id": "BAT",
          "a": "3V3",
          "wiper": "bat",
          "b": "GND",
          "rtotal": 40,
          "wiperPos": 0.7576
        },
        {
          "kind": "diode",
          "id": "D1",
          "anode": "vs",
          "cathode": "out"
        },
        {
          "kind": "diode",
          "id": "D2",
          "anode": "bat",
          "cathode": "out"
        },
        {
          "kind": "pot",
          "id": "BP",
          "a": "bat",
          "wiper": "out",
          "b": "nc1",
          "rtotal": 1000000,
          "wiperPos": 0
        },
        {
          "kind": "pot",
          "id": "RL",
          "a": "nc",
          "wiper": "GND",
          "b": "out",
          "rtotal": 10000,
          "wiperPos": 0.5
        }
      ]
    }
  },
