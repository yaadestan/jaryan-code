    "code": "# jaryan: manba-e motenaveb az do paye-ye barax.\n# halat 0: mosbat-e sabet, 1: manfi-e sabet, 2: moj.\nfrom machine import Pin, ADC, PWM\nimport time\n\nknob = ADC(Pin(34))\nknob.atten(ADC.ATTN_11DB)\nmode = ADC(Pin(33))\nmode.atten(ADC.ATTN_11DB)\np = PWM(Pin(14), freq=1000)\nn = PWM(Pin(26), freq=1000)\n\nHALF = [0, 31, 59, 81, 95, 100, 95, 81, 59, 31]\ntop = round(knob.read() * 33 / 4095) * 31\nstate = round(mode.read() * 2 / 4095)\n\nif state == 0:\n    p.duty(top)\n    n.duty(0)\nelif state == 1:\n    p.duty(0)\n    n.duty(top)\n\nwhile True:\n    if state == 2:\n        for s in HALF:\n            p.duty(top * s // 100)\n            time.sleep(0.01)\n        p.duty(0)\n        for s in HALF:\n            n.duty(top * s // 100)\n            time.sleep(0.01)\n        n.duty(0)\n    else:\n        time.sleep(0.2)\n",
