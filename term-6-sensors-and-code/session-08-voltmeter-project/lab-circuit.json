{
  "key": "term-6-sensors-and-code/session-08-voltmeter-project",
  "config": {
    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# voltmeter.py\n# voltmeter: voltazh-e GPIO 35 zarb-dar 2, rooye OLED.\nfrom machine import Pin, ADC, I2C\nimport ssd1306\nimport time\n\nsensor = ADC(Pin(35))\nsensor.atten(ADC.ATTN_11DB)\ni2c = I2C(0, scl=Pin(22), sda=Pin(21))\noled = ssd1306.SSD1306_I2C(128, 64, i2c)\n\nwhile True:\n    raw = sensor.read()\n    volts = raw * 3.3 / 4095 * 2\n    width = round(volts * 128 / 3.3)\n    print(round(volts, 2))\n    oled.fill(0)\n    oled.text(\"Voltmeter\", 0, 0)\n    oled.text(str(round(volts, 2)) + \" V\", 0, 20)\n    oled.fill_rect(0, 40, width, 10, 1)\n    oled.show()\n    time.sleep(0.5)\n",
    "parts": [
      {
        "type": "oled",
        "sdaPin": 21,
        "sclPin": 22,
        "label": "OLED"
      },
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 100,
        "initial": 100,
        "label": "منبع (درصد)"
      }
    ],
    "analog": {
