{
  "key": "term-6-sensors-and-code/session-07-servo-and-sonar",
  "config": {
    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# servo_sonar.py\n# slider zaviye-ye servo ra midahad; HC-SR04 fasele ra andaze migirad.\nfrom machine import Pin, ADC, PWM, time_pulse_us\nimport time\n\nknob = ADC(Pin(34))\nknob.atten(ADC.ATTN_11DB)\nservo = PWM(Pin(13), freq=50)\ntrig = Pin(5, Pin.OUT)\necho = Pin(18, Pin.IN)\n\nangle = round(knob.read() * 180 / 4095)\nduty = round(26 + angle * 97 / 180)\nservo.duty(duty)\nprint(angle, duty)\n\nwhile True:\n    trig.on()\n    time.sleep_us(10)\n    trig.off()\n    us = time_pulse_us(echo, 1, 30000)\n    if us < 0:\n        print(\"no echo\")\n    else:\n        print(us, round(us / 58, 1))\n    time.sleep(0.5)\n",
    "parts": [
      {
        "type": "servo",
        "pin": 13,
        "label": "Servo"
      },
      {
        "type": "ultrasonic",
        "trigPin": 5,
        "echoPin": 18,
        "maxCm": 200,
        "initial": 100,
        "label": "HC-SR04"
      },
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 180,
        "initial": 90,
        "label": "زاویه (درجه)"
      }
    ],
    "analog": {
      "reads": [
        {
          "pin": 34,
          "net": "knob"
        }
      ],
      "pots": [
        {
          "id": "KNOB",
          "pin": 34,
          "analogMax": 180
        }
      ],
      "components": [
        {
          "kind": "pot",
          "id": "KNOB",
          "a": "3V3",
          "wiper": "knob",
          "b": "GND",
          "rtotal": 10000,
          "wiperPos": 0.5
        },
        {
          "kind": "resistor",
          "id": "R1",
          "a": "3V3",
          "b": "div",
          "ohms": 1000
        },
        {
          "kind": "resistor",
          "id": "R2",
          "a": "div",
          "b": "GND",
          "ohms": 2000
        }
      ]
    }
  },
