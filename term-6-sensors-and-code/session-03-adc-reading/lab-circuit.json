    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# read_volts.py\n# voltazh-e GPIO 34 ra mikhanad va be volt tabdil mikonad.\nfrom machine import Pin, ADC\nimport time\n\nsensor = ADC(Pin(34))\nsensor.atten(ADC.ATTN_11DB)\n\nwhile True:\n    raw = sensor.read()\n    volts = raw * 3.3 / 4095\n    print(raw, round(volts, 2))\n    time.sleep(0.5)\n",
    "parts": [
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 33,
        "initial": 10,
        "label": "ولتاژ ورودی (ضرب‌در ۰٫۱ ولت)"
      },
      {
        "type": "analog",
        "pin": 35,
        "sensor": "ldr",
        "analogMax": 100,
        "initial": 50,
        "label": "نور (درصد)"
      }
    ]
  },
