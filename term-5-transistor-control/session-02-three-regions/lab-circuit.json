{
  "key": "term-5-transistor-control/session-02-three-regions",
  "config": {
    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# jaryan: manba-e voltazh-e ghabel-e tanzim-e azmayeshgah.\n# har gam-e slider 0.1 volt ast; duty * 3.3 / 1023 = tenths / 10 volt.\nfrom machine import Pin, ADC, PWM\nimport time\n\nknob = ADC(Pin(34))\nknob.atten(ADC.ATTN_11DB)\nsupply = PWM(Pin(14), freq=1000)\n\ntenths = round(knob.read() * 33 / 4095)\nsupply.duty(tenths * 31)\n\nwhile True:\n    time.sleep(0.2)\n",
    "parts": [
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 33,
        "initial": 33,
        "label": "ولتاژ منبع (ضرب‌در ۰٫۱ ولت)"
      },
      {
        "type": "analog",
        "pin": 35,
        "sensor": "pot",
        "analogMax": 100,
        "initial": 50,
        "label": "مقاومت base (ضرب‌در ۱۰ کیلواهم)"
      }
    ],
    "analog": {
      "sources": [
        {
          "pin": 14,
          "net": "vs"
        }
      ],
      "reads": [
        {
          "pin": 34,
          "net": "knob"
        }
      ],
      "pots": [
        {
          "id": "KNOB",
          "pin": 34,
          "analogMax": 33
        },
        {
          "id": "RB",
          "pin": 35,
          "analogMax": 100
        }
      ],
      "components": [
        {
          "kind": "pot",
          "id": "KNOB",
          "a": "3V3",
          "wiper": "knob",
          "b": "GND",
          "rtotal": 10000,
          "wiperPos": 0.3
        },
        {
          "kind": "pot",
          "id": "RB",
          "a": "nc",
          "wiper": "b",
          "b": "vs",
          "rtotal": 1000000,
          "wiperPos": 0.5
        },
        {
          "kind": "resistor",
          "id": "R1",
          "a": "3V3",
          "b": "c",
          "ohms": 1000
        },
        {
          "kind": "npn",
          "id": "Q1",
          "c": "c",
          "base": "b",
          "e": "GND"
        }
      ]
    }
  },
