{
  "key": "term-5-transistor-control/session-05-common-emitter",
  "config": {
    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# jaryan: voltazh-e vorudi = markaz + moj-e kuchak.\n# slider 34 markaz, slider 35 damane (har gam 0.1 volt).\nfrom machine import Pin, ADC, PWM\nimport time\n\nknob = ADC(Pin(34))\nknob.atten(ADC.ATTN_11DB)\nsize = ADC(Pin(35))\nsize.atten(ADC.ATTN_11DB)\nsupply = PWM(Pin(14), freq=1000)\n\nHALF = [0, 31, 59, 81, 95, 100, 95, 81, 59, 31]\nWAVE = HALF + [-s for s in HALF]\ncentre = round(knob.read() * 33 / 4095) * 31\namp = round(size.read() * 10 / 4095) * 31\n\nwhile True:\n    for s in WAVE:\n        supply.duty(max(0, min(1023, centre + amp * s // 100)))\n        time.sleep(0.01)\n",
    "parts": [
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 33,
        "initial": 20,
        "label": "مرکز ورودی (ضرب‌در ۰٫۱ ولت)"
      },
      {
        "type": "analog",
        "pin": 35,
        "sensor": "pot",
        "analogMax": 10,
        "initial": 0,
        "label": "دامنهٔ موج (ضرب‌در ۰٫۱ ولت)"
      }
    ],
    "analog": {
