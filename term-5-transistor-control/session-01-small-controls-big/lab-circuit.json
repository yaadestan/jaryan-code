{
  "key": "term-5-transistor-control/session-01-small-controls-big",
  "config": {
    "board": "esp32-devkit-v1",
    "rerunOnInput": true,
    "code": "# jaryan: manba-e voltazh-e ghabel-e tanzim-e azmayeshgah.\n# har gam-e slider 0.1 volt ast; duty * 3.3 / 1023 = tenths / 10 volt.\nfrom machine import Pin, ADC, PWM\nimport time\n\nknob = ADC(Pin(34))\nknob.atten(ADC.ATTN_11DB)\nsupply = PWM(Pin(14), freq=1000)\n\ntenths = round(knob.read() * 33 / 4095)\nsupply.duty(tenths * 31)\n\nwhile True:\n    time.sleep(0.2)\n",
    "parts": [
      {
        "type": "analog",
        "pin": 34,
        "sensor": "pot",
        "analogMax": 33,
        "initial": 20,
        "label": "ولتاژ منبع (ضرب‌در ۰٫۱ ولت)"
      }
    ],
    "analog": {
      "sources": [
        {
          "pin": 14,
          "net": "vs"
        }
      ],
      "reads": [
        {
          "pin": 34,
          "net": "knob"
        }
      ],
      "pots": [
        {
          "id": "KNOB",
          "pin": 34,
          "analogMax": 33
        }
      ],
      "components": [
        {
          "kind": "pot",
          "id": "KNOB",
          "a": "3V3",
          "wiper": "knob",
          "b": "GND",
          "rtotal": 10000,
          "wiperPos": 0.3
        },
        {
          "kind": "resistor",
          "id": "RB",
          "a": "vs",
          "b": "b",
          "ohms": 100000
        },
        {
          "kind": "resistor",
          "id": "R1",
          "a": "3V3",
          "b": "c",
          "ohms": 1000
        },
        {
          "kind": "npn",
          "id": "Q1",
          "c": "c",
          "base": "b",
          "e": "GND"
        }
      ]
    }
  },
  "scenarios": [
    {
      "name": "v0",
      "sliders": {
        "34": 0
      },
      "bench": true,
      "expect": {
        "v:b": 0,
        "v:c": 3.3,
        "i:RB": 0,
        "i:R1": 0
      }
