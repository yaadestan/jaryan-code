    "code": "# guard.py\n# negahban-e tariki, noskhe-ye nahayi ba OLED.\nfrom machine import Pin, ADC, PWM, I2C\nimport ssd1306\nimport time\n\nTHRESHOLD = 0.55\n\nsensor = ADC(Pin(34))\nsensor.atten(ADC.ATTN_11DB)\nlamp = Pin(25, Pin.OUT)\nbuzzer = PWM(Pin(4), freq=880)\nbuzzer.duty(0)\ni2c = I2C(0, scl=Pin(22), sda=Pin(21))\noled = ssd1306.SSD1306_I2C(128, 64, i2c)\n\nwhile True:\n    volts = sensor.read() * 3.3 / 4095\n    print(round(volts, 2))\n    oled.fill(0)\n    oled.text(str(round(volts, 2)) + \" V\", 0, 0)\n    if volts < THRESHOLD:\n        lamp.on()\n        buzzer.duty(512)\n        oled.text(\"DARK\", 0, 20)\n    else:\n        lamp.off()\n        buzzer.duty(0)\n        oled.text(\"LIGHT\", 0, 20)\n    oled.show()\n    time.sleep(0.5)\n",
