    "code": "# guard_design.py\n# negahban-e tariki: ADC rooye GPIO 34, transistor rooye GPIO 25, buzzer rooye GPIO 4.\nfrom machine import Pin, ADC, PWM\nimport time\n\nTHRESHOLD = 0.55\n\nsensor = ADC(Pin(34))\nsensor.atten(ADC.ATTN_11DB)\nlamp = Pin(25, Pin.OUT)\nbuzzer = PWM(Pin(4), freq=880)\nbuzzer.duty(0)\n\nwhile True:\n    volts = sensor.read() * 3.3 / 4095\n    print(round(volts, 2))\n    if volts < THRESHOLD:\n        lamp.on()\n        buzzer.duty(512)\n    else:\n        lamp.off()\n        buzzer.duty(0)\n    time.sleep(0.5)\n",
